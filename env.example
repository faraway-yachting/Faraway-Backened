# ========================================
# FARAWAY BACKEND - ENVIRONMENT CONFIGURATION
# ========================================
# Copy this file to .env.development, .env.production.
# Based on your NODE_ENV setting

# === CORE APPLICATION ===
NODE_ENV=development
PORT=8100
API_VERSION=v1
API_BASE_URL=http://localhost:8100/api
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8100

# === SECURITY ===
JWT_SECRET=your-super-secret-jwt-key-here-minimum-32-characters
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# === DATABASE ===
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database
MONGO_DB_NAME=faraway

# === FILE STORAGE (CLOUDINARY) ===
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# === EMAIL SERVICE ===
ENABLE_EMAIL_SERVICE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SENDER_EMAIL=your-email@gmail.com
SENDER_NAME=Faraway Team

# === ADMIN CONFIGURATION ===
ADMIN_EMAIL=admin@faraway.com
ADMIN_PASSWORD=your-admin-password

# === LOGGING ===
LOG_LEVEL=info

# ========================================
# ENVIRONMENT-SPECIFIC OVERRIDES
# ========================================

# === DEVELOPMENT OVERRIDES ===
# NODE_ENV=development
# LOG_LEVEL=debug
# ENABLE_EMAIL_SERVICE=false

# === PRODUCTION OVERRIDES ===
# NODE_ENV=production
# LOG_LEVEL=warn
# ENABLE_EMAIL_SERVICE=true
# CLOUDINARY_ENABLED=true

#
