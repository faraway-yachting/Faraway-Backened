{
  "name": "faraway-backend",
  "version": "1.0.0",
  "description": "Faraway Yacht Rental Backend API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --exec tsx src/server.ts",
    "dev:debug": "nodemon --exec tsx --inspect src/server.ts",
    "dev:watch": "nodemon --exec tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:dev": "tsc -p tsconfig.build.json --watch",
    "build:prod": "NODE_ENV=production npm run build",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "lint:strict": "eslint src/ --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,md}\"",
    "clean": "rm -rf dist logs/*.log",
    "clean:all": "rm -rf dist node_modules package-lock.json logs/*.log",
    "seed": "tsx scripts/seed.ts",
    "seed:prod": "NODE_ENV=production tsx scripts/seed.ts",
    "setup-env": "tsx scripts/setup-env.ts",
    "env:dev": "cp env.example .env.development",
    "env:prod": "cp env.example .env.production",
    "deploy": "tsx scripts/deploy.ts",
    "deploy:prod": "tsx scripts/deploy.production.ts",
    "docker:build": "docker build -f docker/Dockerfile -t faraway-backend .",
    "docker:run": "docker-compose -f docker/docker-compose.yml up -d",
    "docker:stop": "docker-compose -f docker/docker-compose.yml down",
    "docker:logs": "docker-compose -f docker/docker-compose.yml logs -f",
    "docker:restart": "npm run docker:stop && npm run docker:run",
    "docker:prod": "docker-compose -f docker/docker-compose.production.yml up --build -d",
    "docker:prod:stop": "docker-compose -f docker/docker-compose.production.yml down",
    "docker:prod:logs": "docker-compose -f docker/docker-compose.production.yml logs -f",
    "docker:prod:restart": "npm run docker:prod:stop && npm run docker:prod",
    "health": "curl -f http://localhost:8100/health || echo 'Server not responding'",
    "health:prod": "curl -f http://localhost:3000/health || echo 'Production server not responding'",
    "logs:dev": "tail -f logs/app.log",
    "logs:error": "tail -f logs/error.log",
    "logs:combined": "tail -f logs/combined.log",
    "setup": "npm install && npm run build && npm run seed",
    "setup:prod": "npm ci --only=production && npm run build:prod",
    "reset": "npm run clean:all && npm run setup",
    "reset:prod": "npm run clean:all && npm run setup:prod",
    "prebuild": "npm run clean",
    "prestart": "npm run build",
    "predev": "npm run lint:fix"
  },
  "keywords": [
    "yacht",
    "rental",
    "api",
    "backend",
    "express",
    "mongodb"
  ],
  "author": "Faraway Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.0.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.1",
    "multer": "^2.0.1",
    "nodemailer": "^7.0.5",
    "streamifier": "^0.1.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.14",
    "@types/streamifier": "^0.1.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.1",
    "tsx": "^4.20.5",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
