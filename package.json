{
  "name": "faraway-backend",
  "version": "1.0.0",
  "description": "Faraway Yacht Rental Backend API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --exec ts-node --esm src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:dev": "tsc -p tsconfig.build.json --watch",
    "test": "jest",
    "test:unit": "jest --testPathPattern=src/tests/unit",
    "test:integration": "jest --testPathPattern=src/tests/integration",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "seed": "ts-node --esm scripts/seed.ts",
    "deploy": "ts-node --esm scripts/deploy.ts",
    "deploy:prod": "ts-node --esm scripts/deploy.production.ts",
    "docker:build": "docker build -f docker/Dockerfile -t faraway-backend .",
    "docker:run": "docker-compose -f docker/docker-compose.yml up -d",
    "docker:stop": "docker-compose -f docker/docker-compose.yml down",
    "docker:prod": "docker-compose -f docker/docker-compose.production.yml up --build -d",
    "docker:prod:stop": "docker-compose -f docker/docker-compose.production.yml down",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "health": "node -e \"require('http').get('http://localhost:8100/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) })\"",
    "logs": "docker-compose -f docker/docker-compose.yml logs -f",
    "logs:prod": "docker-compose -f docker/docker-compose.production.yml logs -f"
  },
  "keywords": ["yacht", "rental", "api", "backend", "express", "mongodb"],
  "author": "Faraway Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.0.1",
    "express": "^5.1.0",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.1",
    "multer": "^2.0.1",
    "nodemailer": "^7.0.5",
    "streamifier": "^0.1.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/express": "^4.17.0",
    "@types/cors": "^2.8.0",
    "@types/cookie-parser": "^1.4.0",
    "@types/bcryptjs": "^2.4.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/multer": "^1.4.0",
    "@types/nodemailer": "^6.4.0",
    "@types/jest": "^29.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@types/streamifier": "^0.1.1",
    "@types/cloudinary": "^1.28.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "supertest": "^6.3.0",
    "@types/supertest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
